# ============================================================
# core-project-service — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# Required variables are marked with [REQUIRED].

# --- Application ---
NODE_ENV=development                    # development | staging | production
PORT=8086                               # HTTP server port
LOG_LEVEL=info                          # trace | debug | info | warn | error | fatal
SWAGGER_ENABLED=true                    # Enable /api/docs Swagger UI
CORS_ORIGINS=*                          # Allowed CORS origins (comma-separated)

# --- Database [REQUIRED] ---
DATABASE_URL=postgresql://dev:dev@localhost:5432/visiobook_project?schema=public
DATABASE_POOL_MIN=2                     # Minimum connection pool size
DATABASE_POOL_MAX=10                    # Maximum connection pool size

# --- Redis [REQUIRED] ---
REDIS_HOST=localhost                    # Redis host
REDIS_PORT=6379                         # Redis port
REDIS_PASSWORD=                         # Redis password (leave empty if no auth)
REDIS_DB=0                              # Redis database number
REDIS_TLS_ENABLED=false                 # Enable TLS for Redis connection

# --- NATS [REQUIRED] ---
NATS_URL=nats://localhost:4222          # NATS server URL
NATS_USER=                              # NATS username (optional)
NATS_PASSWORD=                          # NATS password (optional)
NATS_STREAM_NAME=VISIOBOOK_PROJECT      # JetStream stream name

# --- BullMQ ---
BULLMQ_CONCURRENCY=5                   # Max concurrent workflow jobs
BULLMQ_MAX_RETRIES=3                   # Max retries per failed job

# --- External Services [REQUIRED] ---
USER_SERVICE_URL=http://localhost:8081  # Base URL for core-user-service
STORAGE_SERVICE_URL=http://localhost:8084  # Base URL for support-storage-service
NOTIFICATION_SERVICE_URL=http://localhost:8083  # Base URL for core-notification-service
HTTP_CLIENT_TIMEOUT=5000                # HTTP client timeout in milliseconds

# --- Feature Flags ---
FEATURE_SSE_ENABLED=true                # Enable SSE progress streaming
FEATURE_SHARE_ENABLED=true              # Enable share link functionality
FEATURE_SEARCH_ENABLED=true             # Enable full-text search
