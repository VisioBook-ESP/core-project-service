{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,

    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,

    // Mode strict complet
    "strict": true,

    // Déco & NestJS
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    // Compatibilité Node / imports
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // Qualité du code
    "isolatedModules": true,
    "removeComments": true,

    // Rapidité
    "skipLibCheck": true,
  }
}


